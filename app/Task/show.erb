<div class="border d-flex justify-content-between align-items-center p-2">
  <a href="<%= url_for :action => :index %>" class="btn btn-secondary btn-sm">← Back</a>
  <h4 class="mb-0">Task Detail</h4>
  <a href="<%= url_for :action => :edit, :id => @task.object %>"
     class="btn btn-primary btn-sm">Edit</a>
</div>

<div class="container-fluid p-2">
  <ul class="list-group mb-3">
    <li class="list-group-item"><strong>Title:</strong> <%= @task.title %></li>
    <li class="list-group-item"><strong>Status:</strong>
      <span class="label <%= @task.status_badge_class %>"><%= @task.status_label %></span>
    </li>
    <li class="list-group-item"><strong>Assigned To:</strong> <%= @task.assigned_to %></li>
    <li class="list-group-item"><strong>Location:</strong> <%= @task.location %></li>
    <li class="list-group-item"><strong>Description:</strong> <%= @task.description %></li>
    <% if @task.photo_path && !@task.photo_path.empty? %>
      <li class="list-group-item">
        <strong>Photo:</strong><br/>
        <img src="<%= @task.photo_path %>" class="img-responsive" style="max-width:100%;"/>
      </li>
    <% end %>
  </ul>

  <!-- Status quick-update buttons -->
  <div class="btn-group btn-group-justified mb-3" role="group">
    <% ['pending', 'in_progress', 'done'].each do |s| %>
      <a href="<%= url_for :action => :update_status, :id => @task.object,
                           :query => {'status' => s} %>"
         class="btn <%= @task.status == s ? 'btn-primary' : 'btn-default' %>">
        <%= s.split('_').map(&:capitalize).join(' ') %>
      </a>
    <% end %>
  </div>

  <!-- Photo capture -->
  <form method="POST" action="<%= url_for :action => :capture_photo, :id => @task.object %>">
    <button type="submit" class="btn btn-info btn-block">📷 Capture Photo</button>
  </form>

  <br/>
  <a href="<%= url_for :action => :delete, :id => @task.object %>"
     class="btn btn-danger btn-block"
     onclick="return confirm('Delete this task?');">Delete Task</a>
</div>